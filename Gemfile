source "https://rubygems.org"

# Build with Bundler in our own Actions workflow, not the github-pages gem.
gem "jekyll", "4.4.1"

# Windows does not ship the timezone database available on Linux.
gem "tzinfo", "~> 2.0", platforms: [:mswin, :mingw, :x64_mingw]
gem "tzinfo-data", platforms: [:mswin, :mingw, :x64_mingw]
